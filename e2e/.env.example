# Copy to `e2e/.env` for local runs. Local `.env` always uses these plain
# unprefixed E2E_* names for whichever single environment you are testing.
#
# In CI the values come from Forgejo Actions secrets that hold both staging and
# production at once (E2E_STAGING_* / E2E_PRODUCTION_*, plus OIDC_ISSUER_* for
# the OP host). The workflow selects per run and exposes the result on these
# plain names, so the suite itself never sees the prefix (see
# .forgejo/workflows/e2e.yml). Production runs are manual-dispatch only.
#
# Never commit a filled-in .env (e2e/.gitignore already excludes it).

# REQUIRED: hub-web apex the human-facing app is served on. The browser-driven
# projects navigate here. No default; set the per-environment host explicitly
# (staging `https://a8n.systems`, prod `https://psa.systems`).
E2E_BASE_URL=https://a8n.systems

# REQUIRED in CI / recommended locally: OP + API apex. On bunyip the OIDC OP
# and the `/v1/*` JSON API share one host. When unset it is DERIVED from
# E2E_BASE_URL by prepending `api.`, so `a8n.systems` -> `api.a8n.systems`
# (prod `psa.systems` -> `api.psa.systems`). Set explicitly when the deployment
# uses a different naming scheme.
E2E_OP_BASE_URL=https://api.a8n.systems

# OPTIONAL: JSON API host. DERIVED: defaults to E2E_OP_BASE_URL (same host on
# bunyip). Set only if the `/v1/*` API ever moves to its own host.
E2E_API_BASE_URL=

# REQUIRED: pre-provisioned, dedicated E2E account on the deployment.
E2E_EMAIL=e2e@example.test
E2E_PASSWORD=change-me

# REQUIRED: UUID of the dedicated E2E tenant the account belongs to. Used to
# label and scope all test-created records.
E2E_TENANT_ID=00000000-0000-0000-0000-000000000000

# REQUIRED: public OIDC (PKCE) client id used for the OP token-flow test.
E2E_OIDC_CLIENT_ID=bunyip-e2e

# REQUIRED: redirect URI registered for E2E_OIDC_CLIENT_ID. The token-flow
# test only captures the `code` from the 302 Location; it never loads this
# URL. It MUST exactly match a registered redirect_uri for the client, or the
# OP returns invalid_redirect_uri at /oauth2/authorize or /oauth2/token.
E2E_OIDC_REDIRECT_URI=https://a8n.systems/auth/callback

# REQUIRED: base32 TOTP secret for E2E_EMAIL's authenticator. Setup uses it to
# compute the second-factor code at runtime (same string you originally pasted
# into your authenticator app when enrolling 2FA on the account). Treat as
# sensitive; never commit a filled value.
E2E_TOTP_SECRET=

# OPTIONAL: Stripe test-mode secret key (`sk_test_...`) used ONLY by teardown
# to cancel test-mode subscriptions the billing specs create. When unset, that
# teardown step is skipped.
E2E_STRIPE_SECRET_KEY=

# OPTIONAL (staging only): base URL of the Mailpit test mail-sink HTTP API, with
# basicAuth credentials embedded, e.g. https://user:pass@mailpit.a8n.systems.
# The email-driven specs (password-reset, magic-link, change-email) read token
# links from here. Production has no sink, so when this is unset those specs
# SKIP (they never fail on an unconfigured environment). See BUNYIP-150.
E2E_MAIL_SINK_URL=
