# Edge reverse proxy for a self-hosted Bunyip deployment.
#
# The Dioxus SPA derives its backend (the OIDC issuer + `/v1/*` API) at
# runtime as `msp-api.<window.location.host>` (see
# bunyip-web/src/stores/config.rs). So the edge must serve the SPA at the
# apex host and route the `msp-api.` subdomain to the API container.
#
# Both ${BUNYIP_HOST} and msp-api.${BUNYIP_HOST} must resolve to this host
# for Caddy's automatic HTTPS to issue certificates.

{
	email {$CADDY_ACME_EMAIL}
}

# SPA (static Dioxus bundle served by the web container's own Caddy).
{$BUNYIP_HOST} {
	encode gzip zstd
	reverse_proxy web:8080
}

# API / OIDC issuer (the bunyip-api mock backend).
msp-api.{$BUNYIP_HOST} {
	encode gzip zstd
	reverse_proxy api:8080
}
