# Bunyip environment file.
#
# Copy to .env and tweak. The ACTIVE (uncommented) values below are safe for
# local dev only; every one of them needs a real value in a deployment.
#
# NOTE: dotenvy needs quotes around values containing spaces, e.g. APP_NAME.
# NOTE: each variable is defined ONCE in this file. Where dev and production
#       want different values, the dev value is active and the production
#       guidance is in the comment above it.
#
# Grouping (same order as compose.yml):
#   1. Environmental
#   2. Hosting
#   3. Application
#   4. Security and secrets
#   5. Identity provider (OIDC)
#   6. Integrations
#   7. Bootstrap defaults for in-app (DB-backed) settings
#   8. Development, build and test only
#
# The complete catalogue - every variable, its default, which process reads it,
# and which compose file passes it - is docs/configuration.md. That document
# also lists the settings that live ONLY in the database (Stripe credentials,
# pricing tiers, and the rest), which have no environment variable at all.


# ═══════════════════════════════════════════════════════════════════════════
# 1. ENVIRONMENTAL
# ═══════════════════════════════════════════════════════════════════════════

# `production` turns on the strict posture: email must resolve to enabled or
# the api refuses to start (BUNYIP-204), an OIDC kid starting with `dev-`
# panics at boot (BUNYIP-258), and JWT_SECRET / BUNYIP_WEBHOOK_SIGNING_SECRET
# lose their dev fallbacks. Anything other than the literal `production`
# (e.g. `development`, `staging`) is treated as non-production.
# Unset defaults to `production`.
ENVIRONMENT=development

# Tracing filter, standard `RUST_LOG` syntax. Read by both binaries.
RUST_LOG=info,bunyip_api=debug,bunyip_core=info


# ═══════════════════════════════════════════════════════════════════════════
# 2. HOSTING
# ═══════════════════════════════════════════════════════════════════════════

# ── Host-published ports and interface ──────────────────────────────────────
# The HOST side of the compose port mappings. Container-internal binds are
# fixed in the compose files, so these only decide what is reachable from the
# host. Default is loopback only; front these with a reverse proxy
# (Traefik/Caddy/nginx) that terminates TLS.
#
# NOTE: this HOST_IP is NOT the in-container bind address. Both compose files
# hard-code the container's own HOST_IP to 0.0.0.0. Setting 0.0.0.0 here
# publishes the plaintext listeners on every host interface (not recommended).
HOST_IP=127.0.0.1
BUNYIP_API_PORT=4401
BUNYIP_WEB_PORT=4400
# OCI registry listener (only used when OCI_REGISTRY_ENABLED=true).
BUNYIP_OCI_PORT=18081

# ── Postgres (the `postgres` compose service) ───────────────────────────────
POSTGRES_USER=bunyip
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=bunyip
# The api reaches Postgres over the compose network by service name.
DATABASE_URL=postgres://bunyip:devpassword@postgres:5432/bunyip

# ── Row level security pool (BUNYIP-344 / BUNYIP-360) ───────────────────────
# Self-service reads (the trusted-devices list, the /v1/downloads entitlement
# set, trusted-device revoke) run on APP_DATABASE_URL so the fail-closed
# `user_isolation` RLS policy actually constrains them. That connection MUST be
# a NOBYPASSRLS role, because the primary DATABASE_URL role bypasses RLS
# (making the policy a no-op).
#
# You do NOT provision the role by hand: when BUNYIP_APP_PASSWORD is set, the
# api idempotently creates the `bunyip_app` (NOSUPERUSER NOBYPASSRLS) role at
# startup over the primary superuser pool, after migrations, and sets this
# password on it. APP_DATABASE_URL then connects the self-service pool as that
# role, so the password embedded there MUST equal BUNYIP_APP_PASSWORD.
#
# `just dev` activates RLS automatically: compose.dev.yml defaults both values
# off POSTGRES_PASSWORD. Leave BUNYIP_APP_PASSWORD unset to skip provisioning
# and keep isolation at the application `WHERE user_id` layer only (RLS no-op).
# Both support the `_FILE` secret convention (prod uses /run/secrets/*).
# BUNYIP_APP_PASSWORD=devpassword
# APP_DATABASE_URL=postgres://bunyip_app:devpassword@postgres:5432/bunyip

# ── Reverse-proxy trust (BUNYIP-311 / BUNYIP-409) ───────────────────────────
# Comma-separated CIDR ranges of trusted reverse proxies. X-Forwarded-For /
# X-Real-IP are honoured only when the immediate socket peer is inside one of
# these ranges; every other peer is keyed off its real socket address (closes
# the auto-ban IP-spoofing vector). Empty = trust no forwarding headers.
#
# Client IP travels a two-hop chain Traefik -> bunyip-web -> bunyip-api, and
# each hop trusts the hop in FRONT of it:
#   - TRUSTED_PROXY_CIDR (the `api` service) MUST include bunyip-web's address
#     on the bunyip-private network (so SSR-proxied /v1 calls surface the
#     end-user IP) AND the edge proxy's address (so direct-to-API paths - SSE,
#     OIDC, external RPs - resolve it too).
#   - WEB_TRUSTED_PROXY_CIDR (the `web` service) MUST include the edge proxy
#     (Traefik) address, so bunyip-web trusts the inbound XFF Traefik sets
#     before forwarding the resolved end-user IP to bunyip-api.
#
# Both are empty here (dev default: no forwarding trusted). compose.yml
# defaults BOTH to the RFC1918 ranges when unset, which is what a normal
# single-host deployment behind Traefik wants. Full walkthrough:
# docs/client-ip-forwarding.md.
TRUSTED_PROXY_CIDR=
WEB_TRUSTED_PROXY_CIDR=

# ── Server-to-server URL: bunyip-web -> bunyip-api ──────────────────────────
# No trailing /v1; the BFF appends it. Defaults to the internal compose
# network hostname.
BUNYIP_API_URL=http://api:4401

# Browser-facing origin of bunyip-api (BUNYIP-192 / BUNYIP-510). Used for the
# dashboard SSE subscriber and the Stripe webhook URL the admin page prefills.
# Unset falls back to BUNYIP_API_URL, which no browser and no Stripe delivery
# can reach. REQUIRED in any deployment where those differ.
# BUNYIP_API_PUBLIC_ORIGIN=https://api.bunyip.example.com

# ── Published images (compose.yml only) ─────────────────────────────────────
# BUNYIP-237: REQUIRED. compose.yml refuses to start without these. Pin a
# specific release tag (e.g. :v0.4.1) - `:latest` + `pull_policy: always`
# resolves the tag at restart time, so two restarts seconds apart can pull two
# different digests and the LB serves mixed builds. Bump the tag on a
# deliberate operator action when promoting a release.
BUNYIP_API_IMAGE=dev.a8n.run/psa-systems-private/bunyip-api:v0.4.1
BUNYIP_WEB_IMAGE=dev.a8n.run/psa-systems-private/bunyip-web:v0.4.1


# ═══════════════════════════════════════════════════════════════════════════
# 3. APPLICATION
# ═══════════════════════════════════════════════════════════════════════════

# Product name in the UI, email subjects and email templates.
APP_NAME="PSA Systems"

# Public base URL of the app, used for links inside transactional email and as
# the first fallback for the SMTP EHLO name.
#
# NOT PASSED THROUGH by compose.yml or compose.dev.yml today, so setting it
# here has no effect on a compose deployment: the api falls back to the FIRST
# CORS_ORIGIN entry, then to http://localhost:5173. To use it, add
# `APP_URL: ${APP_URL:-}` to the api service's `environment:` block.
# APP_URL=https://bunyip.example.com

# Public apex domain (bunyip-web). Used to derive per-app subdomain links
# (e.g. chat.<domain>). Empty leaves those links unresolved.
# BUNYIP_APP_DOMAIN=a8n.systems

# Branding overrides for bunyip-web. Unset uses the built-in Bunyip strings.
# BRAND_DESCRIPTION="Bunyip - the SaaS layer for your PSA."
# BRAND_THEME_CSS=/assets/custom-theme.css


# ═══════════════════════════════════════════════════════════════════════════
# 4. SECURITY AND SECRETS
# ═══════════════════════════════════════════════════════════════════════════
#
# In production these values do NOT come from .env: they are file-based compose
# secrets under ./secrets/* (see the compose.yml header quick start, plus the
# production notes in docs/oci-registry-verification.md). Every secret below
# also accepts a {NAME}_FILE variant pointing at a file the api reads instead
# of the plain env var.
#
# compose.yml mounts a top-level `secrets:` block; each secret is one value in
# a file under ./secrets/ (gitignored). All eleven files must exist before
# `docker compose up`. An empty file means "feature not configured" (e.g. an
# empty forgejo_api_token keeps the distribution proxy disabled), EXCEPT
# postgres_password, database_url, jwt_secret, webhook_signing_secret and
# app_encryption_key, which must be non-empty (the api reports the missing ones
# as startup errors and exits on ENVIRONMENT=production, BUNYIP-537):
#   ./secrets/postgres_password
#   ./secrets/database_url
#   ./secrets/bunyip_app_password
#   ./secrets/app_database_url
#   ./secrets/jwt_secret
#   ./secrets/webhook_signing_secret
#   ./secrets/app_encryption_key
#   ./secrets/setup_default_admin
#   ./secrets/forgejo_api_token
#   ./secrets/update_check_token
# Create them with ./scripts/init-secrets.nu (or `just init-secrets`); it
# generates strong values, migrates any existing .env values, and derives
# database_url from postgres_password.
#
# Upgrading a deployment created before BUNYIP-537: create
# ./secrets/webhook_signing_secret BEFORE `docker compose up`, or compose
# aborts because the secret file is missing. On the docker hosts, add the value
# to the SOPS compose-secrets.yml.

# ── Where the governed secrets live (BUNYIP-542) ────────────────────────────
# environment | database | infisical. REQUIRED: compose.yml has no default and
# aborts without it, and the api exits with an explanatory error on an
# unrecognised value. It declares the ONE store holding the SMTP password and
# the two Stripe secrets; nothing else is consulted, so a copy in an undeclared
# store is reported rather than silently used.
#
# `database` matches a deployment whose secrets were entered on the admin pages.
# The dev compose files default to it, so `just dev` works without this line.
# Migration between stores: docs/secrets-infisical.md.
SECRETS_STORAGE=database

# ── Signing keys ────────────────────────────────────────────────────────────
# JWT signing secret (HS256 for session tokens). 32+ chars. In production this
# is the jwt_secret compose secret and the api refuses to start without it.
JWT_SECRET=dev-only-jwt-secret-at-least-32-characters-long-000000

# BUNYIP-332: dedicated HMAC-SHA256 secret for OUTBOUND webhook dispatches
# (account_deleted, maintenance_change, active_change), held by the receiving
# RP as its own BUNYIP_WEBHOOK_SECRET. Separate from JWT_SECRET so verifying a
# bunyip webhook does not require bunyip's access-token signing key.
# Generate: openssl rand -hex 32. In production it is the
# webhook_signing_secret compose secret and the api refuses to start without it
# (BUNYIP-537); dev falls back to this placeholder.
BUNYIP_WEBHOOK_SIGNING_SECRET=dev-only-webhook-signing-secret-000000000000000000

# ── At-rest encryption (BUNYIP-483) ─────────────────────────────────────────
# The ONE AES-256-GCM at-rest key (hex, 32 bytes). It encrypts the TOTP
# secrets, the Stripe secrets and the SMTP password stored in the database.
# Generate: openssl rand -hex 32   (omit in dev to use the all-zero dev key.)
APP_ENCRYPTION_KEY=

# Comma-separated hex keys still needed to READ rows written under an earlier
# key: during a rotation, or while migrating a deployment that used the two
# retired per-consumer keys (list both here, newest first). Run
# `docker compose run --rm api reencrypt-secrets` to rewrite every row under
# APP_ENCRYPTION_KEY, then clear this. Empty on a fresh deployment.
APP_ENCRYPTION_KEY_PREV=

# Version stamped on rows written under APP_ENCRYPTION_KEY. Bump it when you
# rotate the key, so the rotation status pages can tell old rows from new.
# NOT passed through by compose.yml; add it to the api `environment:` block to
# use it. Defaults to 1. Runbook: docs/encryption-key-rotation.md.
# APP_KEY_VERSION=1

# ── Browser origin, CORS and CSRF ───────────────────────────────────────────
# Public origin(s) the bunyip-web app is served from, comma-separated.
# BUNYIP-423: the same list is the CSRF allow-list, so a browser origin missing
# here gets its cookie-authenticated POST/PUT/PATCH/DELETE refused with 403.
# It is ALSO the fallback source for the app's base URL (see APP_URL above).
# Required in production. Example: https://bunyip.example.com
CORS_ORIGIN=http://localhost:4400

# Cookie scope. Empty = cookies scoped to the exact hostname (right for
# localhost). BUNYIP-266: setting COOKIE_DOMAIN alone is NOT enough to share
# the OP session cookie across subdomains - BUNYIP_COOKIE_SHARED_DOMAIN=true
# must opt in as well, and a mismatch logs a warning at boot.
COOKIE_DOMAIN=
# BUNYIP_COOKIE_SHARED_DOMAIN=false   # not passed through by compose.yml

# Extra hosts appended to the bunyip-web Content-Security-Policy, comma
# separated. Not passed through by compose.yml.
# CSP_CONNECT_SRC=
# CSP_FORM_ACTION=

# ── First-admin bootstrap ───────────────────────────────────────────────────
# Seed an initial platform admin on first boot (email:password).
SETUP_DEFAULT_ADMIN=admin@bunyip.local:ChangeMeBunyip2026

# BUNYIP-290: bootstrap the FIRST admin without a password in env. Whoever
# signs up / signs in with this email is promoted to admin, but only while no
# admin exists yet. Inert once any admin exists; further admins are added via
# the in-app admin-invite flow. Unset = no auto-created admin. Value is trimmed
# and lowercased. The *_FILE secret convention does not apply (plain env only).
# BUNYIP-413: this first admin is also the SUPER ADMIN (`users.is_super_admin`),
# the only account allowed to change rate limits or ban IPs by hand. On an
# existing deployment the flag is backfilled onto the earliest-created admin.
BOOTSTRAP_ADMIN_EMAIL=admin@bunyip.local

# ── Opt-in abuse gates ──────────────────────────────────────────────────────
# Both default to false and neither is passed through by compose.yml.
# BUNYIP-373: the suspicious-login approval gate (it can withhold a login).
# LOGIN_APPROVAL_ENABLED=false
# BUNYIP-377: the signup bot guard. Enable only once every register form
# carries the honeypot + timing token, or real signups are rejected.
# SIGNUP_BOT_GUARD_ENABLED=false


# ═══════════════════════════════════════════════════════════════════════════
# 5. IDENTITY PROVIDER (OIDC)
# ═══════════════════════════════════════════════════════════════════════════
#
# bunyip-api IS the OpenID Provider: it holds the signing key and serves
# /.well-known/* + /oauth2/*. bunyip-web is a relying party that SSOs its users
# against bunyip-api; mokosh-server is a Resource Server only (no signing key,
# no /oauth2/*). See compose.dev-sso.yml.

# ── bunyip-api as the OP ────────────────────────────────────────────────────
# Presence of OIDC_ISSUER enables /oauth2/* and /.well-known/*. Set it to the
# public api origin in production; leave empty to disable the OIDC provider.
OIDC_ISSUER=http://localhost:4401

# Ed25519 signing keys. Generate into ./secrets/oidc (gitignored), mounted into
# the api container at /run/secrets/oidc:
#   openssl genpkey -algorithm ed25519 -out secrets/oidc/dev-2026.pem
#   openssl pkey -in secrets/oidc/dev-2026.pem -pubout -out secrets/oidc/dev-2026.pub.pem
#
# BUNYIP-258: both values are REQUIRED at `compose up` and have no default in
# compose.yml. Production must override to a `prod-*` kid (the api panics at
# boot when ENVIRONMENT=production and the kid starts with `dev-`).
OIDC_JWT_PRIVATE_KEY_PATH=/run/secrets/oidc/dev-2026.pem
OIDC_JWT_ACTIVE_KID=dev-2026
OIDC_JWT_PUBLIC_KEYS_DIR=/run/secrets/oidc

# Token lifetimes and identifiers. None are passed through by compose.yml; the
# built-in defaults are shown. Access-token TTL is clamped to 60-900s and the
# code TTL is capped at 120s regardless of what is set here.
# OIDC_ACCESS_TOKEN_TTL_SECONDS=600
# OIDC_REFRESH_TOKEN_TTL_SECONDS=2592000
# OIDC_REFRESH_IDLE_TTL_SECONDS=1209600
# OIDC_CODE_TTL_SECONDS=60
# OIDC_RS_AUDIENCE=urn:bunyip:rs
# OIDC_LIFECYCLE_EVENT_KEY=urn:bunyip:event:user-lifecycle

# ── bunyip-web as a relying party ───────────────────────────────────────────
# These are CONTAINER environment variables, not build args, so one image
# serves any environment: change a value, restart the container, no rebuild.
#
# OP (bunyip-api) issuer URL. Optional: when unset bunyip-web defaults the
# issuer to its configured BUNYIP_API_URL; set this only to point at an issuer
# origin that differs from the API origin.
BUNYIP_OIDC_ISSUER=https://${USER}-bunyip-api.a8n.run

# UUID of the bunyip-web client row in bunyip-api's oauth_clients table.
# Required for SSO. Empty until `just register-dev-clients` is run (it registers
# the hub + SPA clients in bunyip-api); paste the printed hub UUID here.
# Passed through by compose.dev-sso.yml only.
BUNYIP_OIDC_CLIENT_ID=

# OIDC redirect URI registered for the bunyip-web client. When set it must
# match a row in oauth_clients.redirect_uris in bunyip-api.
BUNYIP_OIDC_REDIRECT_URI=https://${USER}-bunyip.a8n.run/auth/callback

# Optional. Defaults to `openid email offline_access` when unset.
BUNYIP_OIDC_SCOPES=openid email offline_access


# ═══════════════════════════════════════════════════════════════════════════
# 6. INTEGRATIONS
# ═══════════════════════════════════════════════════════════════════════════

# ── Infisical: the governed secrets, when SECRETS_STORAGE=infisical ─────────
# Group-1 startup secrets (postgres, DATABASE_URL, APP_ENCRYPTION_KEY,
# JWT_SECRET, ...) are file-based and NEVER come from Infisical, so Infisical is
# never a boot dependency in the other two stores. Under
# SECRETS_STORAGE=infisical the read is fail-closed: an unreachable instance or
# a missing key aborts startup, because that store was declared as the store of
# record.
#
# NONE of these are passed through by compose.yml today. To use the infisical
# store on a compose deployment, add them to the api service's `environment:`
# block. INFISICAL_CLIENT_ID / _CLIENT_SECRET honour the {NAME}_FILE convention
# and can themselves be Group-1 file secrets. The machine identity needs read
# access, plus write access when secrets are saved from the admin pages or
# copied in with `secrets-migrate --to infisical`.
# Runbook: docs/secrets-infisical.md.
# INFISICAL_ENABLED=false
# INFISICAL_ADDRESS=https://infisical.example.com
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_SECRET_PATH=/runtime
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=

# ── Email (SMTP). Disabled in dev. ──────────────────────────────────────────
# The NON-SECRET settings here are BOOTSTRAP DEFAULTS. Once an admin fills in
# the admin UI (Email settings), the email_config DB row overrides them PER
# FIELD and applies without a restart (BUNYIP-351). A wiped DB falls back to
# these values.
#
# In production, email must resolve to enabled or the api refuses to start
# (BUNYIP-204). That check runs against the ENVIRONMENT ONLY, before the DB row
# is read, so a GUI-configured deployment still needs either a real SMTP_HOST
# or EMAIL_ENABLED=true here.
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com          # non-empty, non-"localhost" => sending on in prod
# SMTP_PORT=465                        # defaults 465 (implicit TLS) / 587 (starttls)
# SMTP_TLS=implicit                    # implicit | starttls
# SMTP_USERNAME=
# SMTP_PASSWORD is a GOVERNED SECRET (BUNYIP-542): it comes from the ONE store
# SECRETS_STORAGE names, never from a precedence chain. Under
# SECRETS_STORAGE=environment it is read file-backed only, as
# SMTP_PASSWORD_FILE. See docs/secrets-infisical.md.
# EHLO/HELO name announced to the relay (BUNYIP-507), resolved when the SMTP
# transport is built - after the DB row is merged. Unset falls back to the host
# of APP_URL (not passed through by compose, so in practice the host of
# CORS_ORIGIN), then the domain of the RESOLVED from-address
# (email_config.from_email when set, else SMTP_FROM), then lettre's default.
# There is no admin-UI field for it: it is deployment identity, not SMTP tuning.
# SMTP_EHLO_NAME=mail.example.com
# SMTP_FROM=PSA Systems <noreply@example.com>
# ADMIN_NOTIFICATION_EMAILS=ops@example.com,alerts@example.com
# Dev only: log the full magic-link / reset URL (token included) at DEBUG when
# sending is disabled. Forced off in production (BUNYIP-204).
# EMAIL_LOG_TOKENS=false

# ── Stripe: two governed secrets, everything else DB-only ───────────────────
# Membership subscriptions are exercised against Stripe TEST MODE, never a
# separate sandbox: test cards (e.g. 4242 4242 4242 4242) only authorize
# against test-mode keys and are rejected in live mode, so this path cannot
# move real money. Full walkthrough + test-card list: docs/stripe-test-mode.md
# (BUNYIP-175).
#
# The secret key and the webhook signing secret are GOVERNED SECRETS
# (BUNYIP-542): they come from the ONE store SECRETS_STORAGE names. Under
# SECRETS_STORAGE=environment they are read file-backed only, as
# STRIPE_SECRET_KEY_FILE and STRIPE_WEBHOOK_SECRET_FILE; the plain spelling is
# never read, because a key in a compose `environment:` block is visible to
# `docker inspect` (BUNYIP-38). scripts/check-no-stripe-env.nu fails the build
# on any other Stripe-shaped name.
#
# The NON-SECRET Stripe configuration (app tag, checkout URLs, trial length,
# price ids) stays DB-only (BUNYIP-482): enter it on the admin Stripe page,
# where a save applies without a restart. Unconfigured means payment is simply
# disabled.
#
#   - Secret key: Stripe Dashboard (Test mode -> Developers -> API keys),
#     starts with sk_test_.
#   - Webhook signing secret: for local dev, the whsec_ value PRINTED BY
#     `stripe listen --forward-to http://localhost:4401/v1/webhooks/stripe`
#     (specific to that CLI session, different from a dashboard endpoint secret).
#   - Checkout success/cancel URLs default to the FIRST CORS_ORIGIN entry. That
#     is correct for plain `just dev` (http://localhost:4400) AND for dev-sso,
#     whose comma-list leads with the bunyip origin. Override on the admin
#     Stripe page only when the first entry is not the bunyip origin.
#
# The at-rest key that encrypts those DB-stored secrets is APP_ENCRYPTION_KEY
# in section 4; it is key material, not Stripe configuration.
#
# The one remaining billing env var is a bootstrap default (section 7).

# ── Distribution proxy: member downloads + OCI registry (BUNYIP-28) ─────────
# Bunyip proxies Mokosh product artifacts (binaries + container images) from
# the private Forgejo instance to entitled members. Both verticals stay
# disabled until FORGEJO_BASE_URL and FORGEJO_API_TOKEN are set.
#
# The token is a Forgejo SERVICE-ACCOUNT token. Required scopes and the
# generation procedure: docs/oci-registry-verification.md (Prerequisites).
FORGEJO_BASE_URL=https://dev.a8n.run
FORGEJO_API_TOKEN=

# OCI registry proxy. Members docker-login with their Bunyip credentials; the
# api answers the docker registry v2 protocol on its own port and fetches
# blobs/manifests from Forgejo with the service token above.
OCI_REGISTRY_ENABLED=false
#
# Registry hostname + token-endpoint realm. LEAVE BOTH UNSET unless needed:
#   - dev (just dev): compose.dev.yml supplies localhost defaults that track
#     BUNYIP_OCI_PORT automatically.
#   - production: set ONLY OCI_REGISTRY_SERVICE to the public registry
#     hostname behind TLS (e.g. registry.example.com); the realm then defaults
#     to https://$OCI_REGISTRY_SERVICE/auth/token in code.
# Setting OCI_REGISTRY_REALM to a localhost URL in production breaks every
# docker login (clients are told to fetch tokens from localhost).
#OCI_REGISTRY_SERVICE=registry.example.com
#OCI_REGISTRY_REALM=
#
# Optional tuning knobs (defaults shown). All are passed through by both
# compose.yml and compose.dev.yml (BUNYIP-42).
# Cache size caps (bytes):
#OCI_BLOB_CACHE_MAX_BYTES=53687091200
#DOWNLOAD_CACHE_MAX_BYTES=10737418240
# Per-user usage limits:
#OCI_PULLS_PER_USER_PER_DAY=50
#DOWNLOAD_DAILY_LIMIT_PER_USER=50
#OCI_CONCURRENT_MANIFESTS_PER_USER=2
#DOWNLOAD_CONCURRENCY_PER_USER=2
# Cache TTLs (seconds) and registry token lifetime (seconds):
#OCI_MANIFEST_CACHE_TTL_SECS=300
#FORGEJO_RELEASE_CACHE_TTL_SECS=300
#OCI_TOKEN_TTL_SECS=900

# ── Mokosh (BUNYIP-356) ─────────────────────────────────────────────────────
# Server-to-server base URL of mokosh-server for account backup/restore. When
# set (and OIDC is enabled and the mokosh-apps OAuth client exists), the Backup
# add-on captures/restores Mokosh tenant data by calling Mokosh's
# /api/v1/data/{export,import} with a short-lived, bunyip-minted
# Mokosh-audience at+jwt for the acting admin. Leave empty to keep Mokosh a
# pending stub (recorded "unavailable" in the account bundle).
# Point it at the SAME mokosh host used for MOKOSH_WEBHOOK_URL: on dev-sso the
# external Traefik host below; in prod mokosh-server's reachable base URL. The
# token audience comes from the mokosh-apps client record, not this URL.
# NOTE: restore additionally needs mokosh-server PMS-648 (import is WIP);
# backup works as soon as this is set. Passed through by compose.dev-sso.yml
# only.
# MOKOSH_BACKUP_API_URL=https://${USER}-mokosh-api.a8n.run

# Outbound webhook endpoint written onto the `mokosh` row in `applications` at
# boot. Unset skips the update and leaves whatever the row already holds. Not
# passed through by any compose file.
# MOKOSH_WEBHOOK_URL=https://mokosh.example.com/api/v1/bunyip/webhook

# ── Let's Chat OIDC client registration ─────────────────────────────────────
# Upserts the Let's Chat row in oauth_clients at boot. Both REDIRECT_URIS and
# AUDIENCE must be set or registration is skipped (and logged). The secret hash
# is optional: unset keeps the shared hash the migration seeded. All four
# honour the {NAME}_FILE convention; none is passed through by compose.yml.
# LETS_CHAT_REDIRECT_URIS=https://chat.example.com/auth/bunyip/callback
# LETS_CHAT_AUDIENCE=urn:lets-chat
# LETS_CHAT_POST_LOGOUT_REDIRECT_URIS=
# LETS_CHAT_CLIENT_SECRET_HASH=

# BUNYIP-329: URL of the team Let's Chat ("Community") instance the sidebar
# Community button opens. Empty (default) disables the feature (button hidden),
# so a deploy without a Let's Chat instance never shows a dead link. Let's Chat
# is already an OIDC client of bunyip-api, so opening this URL logs the member
# in via their existing session (no separate login). Point it at the login-init
# path so the OIDC flow fires immediately.
# Staging/prod example: BUNYIP_COMMUNITY_URL=https://chat.a8n.systems/auth/bunyip
BUNYIP_COMMUNITY_URL=

# ── Update checker (operator-facing) ────────────────────────────────────────
# Endpoint the api polls for a newer release. Empty disables the check. The
# paired token is the update_check_token compose secret (or the plain
# BUNYIP_UPDATE_CHECK_TOKEN var in dev).
# BUNYIP_UPDATE_CHECK_URL=
# BUNYIP_UPDATE_CHECK_TOKEN=

# ── GeoIP enrichment for login-location alerts ──────────────────────────────
# Optional .BIN database paths. Unset leaves the feature off; neither is passed
# through by compose.yml, and neither file ships with the image, so a
# deployment must mount them first.
# BUNYIP-366: country resolution.
# IP2LOCATION_DB_PATH=/var/lib/bunyip/IP2LOCATION.BIN
# BUNYIP-437: ASN / VPN enrichment.
# IP2PROXY_DB_PATH=/var/lib/bunyip/IP2PROXY.BIN


# ═══════════════════════════════════════════════════════════════════════════
# 7. BOOTSTRAP DEFAULTS FOR IN-APP (DB-BACKED) SETTINGS
# ═══════════════════════════════════════════════════════════════════════════
#
# Everything in this section is a SEED VALUE ONLY. Precedence is
# const -> env -> DB row, and once an admin saves the setting in the admin UI
# the DB row wins and applies without a restart. A wiped DB falls straight back
# to these. None of them is passed through by compose.yml, so a deployment that
# wants a non-default seed must add it to the api service's `environment:`.
# The email bootstrap defaults are the same kind of value and live in section 6.

# ── Auto-ban (admin page: Auto-ban settings) ────────────────────────────────
# AUTO_BAN_ENABLED=true          # false/0 disables auto-banning entirely
# AUTO_BAN_THRESHOLD=5           # suspicious requests before an IP is banned
# AUTO_BAN_WINDOW_SECS=3600      # rolling window strikes accumulate over
# AUTO_BAN_DURATION_SECS=86400   # how long a ban lasts before it expires
# An IP can also be banned (and lifted) by hand from the admin IP Bans screen;
# that is super-admin-only and takes effect on the address's next request.

# ── Rate limits (admin page: Rate Limits, BUNYIP-413) ───────────────────────
# Every rate-limited action has a built-in cap and window, named
# RATE_LIMIT_{ACTION}_MAX_REQUESTS and RATE_LIMIT_{ACTION}_WINDOW_SECONDS for
# each action in `RateLimitConfig::ALL` (login, magic_link, password_reset,
# api_auth, api_unauth, registration, oci_token_failures,
# oci_token_throughput, two_factor_verify_failures, oci_token_ip_failures,
# oauth_token, oauth_authorize, oauth_userinfo, oauth_revoke, oauth_discovery,
# feedback_submit, smtp_test). Either half may be set alone; an unparseable or
# non-positive value is ignored.
# RATE_LIMIT_LOGIN_MAX_REQUESTS=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ── Membership tiers (admin page: Pricing tiers) ────────────────────────────
# Slot counts and trial lengths only. The Stripe price/product ids and the
# public-pricing switch have NO env source at all: they are written by the
# admin tier-settings page (BUNYIP-482).
# TIER_LIFETIME_SLOTS=5
# TIER_EARLY_ADOPTER_SLOTS=5
# TIER_EARLY_ADOPTER_TRIAL_DAYS=90
# TIER_STANDARD_TRIAL_DAYS=30

# ── Billing (admin page: Stripe) ────────────────────────────────────────────
# Signup free-trial length in days (0-365, default 30). The DB override lives
# on the admin Stripe page.
# BUNYIP_BILLING_TRIAL_PERIOD_DAYS=30


# ═══════════════════════════════════════════════════════════════════════════
# 8. DEVELOPMENT, BUILD AND TEST ONLY
# ═══════════════════════════════════════════════════════════════════════════

# Host UID/GID for the in-container `dev` user (match your host user so
# bind-mounted files stay host-owned). `just dev` rewrites these automatically.
HOST_UID=1000
HOST_GID=1000

# In-container bind address and port when the api binary is run DIRECTLY
# (cargo run). Both compose files hard-code these on the container, so setting
# them here changes nothing under `just dev` or `docker compose up`.
# HOST_IP is the host-publish interface in section 2, a different setting.
# APP_PORT=4401

# bunyip-web's own listener, same story: compose hard-codes it.
# BUNYIP_BIND_ADDR=0.0.0.0:4400

# Building the dunite git dependency. bunyip-domain/oci/oidc depend on
# https://dev.a8n.run/psa-systems/dunite, which is anonymously readable, so
# this is only needed for a mirror that requires auth. The dev image configures
# git to use it when set.
DUNITE_GIT_TOKEN=

# Seed / E2E harness gates. Refuse to run unless explicitly allowed, and the
# seed binary additionally refuses on a production ENVIRONMENT.
# BUNYIP_SEED_ALLOW=false
# BUNYIP_E2E_BOOTSTRAP_ALLOW=false
# BUNYIP_E2E_TOTP_SECRET=          # base32; only for --enable-2fa

# Build metadata. Set by CI as a build arg; unset yields an empty commit in the
# version endpoint.
# BUNYIP_GIT_SHA=
