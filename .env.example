# Bunyip dev env.
#
# Copy to .env and tweak. Defaults below are safe for local dev only.

# Host UID/GID for the in-container `dev` user (match your host user so
# bind-mounted files stay host-owned). `just dev` rewrites these automatically.
HOST_UID=1000
HOST_GID=1000

# Where the bunyip-api binary listens. The internal-to-Docker bind is fixed in
# compose.dev.yml; this controls the host-side published port.
BUNYIP_API_PORT=4401
BUNYIP_WEB_PORT=4400

# What the API thinks the public-facing URL is (used in OIDC discovery JSON).
BUNYIP_PUBLIC_BASE_URL=http://localhost:4400

# Cookie signing secret. Must be at least 64 bytes in production. The default
# below is the placeholder shipped in .env.example; replace it before deploying
# anywhere reachable from the internet.
COOKIE_SECRET=dev-only-do-not-use-in-prod-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Mock credentials accepted by the dev API. Any seeded email + this password
# succeeds. Disable in prod by setting MOCK_PASSWORD to an empty string.
MOCK_PASSWORD=demo
MOCK_TOTP_CODE=000000

# Optional: create Forgejo issues from in-app feedback submissions. Leave empty
# to disable. Format: "owner/repo". When set, also provide FEEDBACK_FORGEJO_TOKEN.
FEEDBACK_FORGEJO_REPO=
FEEDBACK_FORGEJO_TOKEN=

# Tracing.
RUST_LOG=info,bunyip_api=debug

# ---------------------------------------------------------------------------
# Mokosh-server OIDC client (baked into the bunyip-web wasm at build time).
# Values change when you re-register the client with
# `just register-bunyip-client` in the mokosh-server repo. The container needs
# `force-recreate` after .env edits so the new value reaches the build env.
# ---------------------------------------------------------------------------

# URL of the mokosh-server IdP that bunyip-web talks to.
BUNYIP_OIDC_ISSUER=https://${USER}-mokosh-api.a8n.run

# UUID of the bunyip-web row in mokosh_auth.oauth_clients. Empty until
# `just register-bunyip-client` is run; paste the printed UUID here.
BUNYIP_OIDC_CLIENT_ID=

# Where mokosh-server's authorize endpoint redirects on a successful code
# grant. Must match one of the rows in oauth_clients.redirect_uris.
BUNYIP_OIDC_REDIRECT_URI=https://${USER}-bunyip.a8n.run/auth/callback

# Optional. Defaults to `openid email offline_access` when unset.
BUNYIP_OIDC_SCOPES=openid email offline_access
