# Bunyip dev env.
#
# Copy to .env and tweak. Defaults below are safe for local dev only.

# Host UID/GID for the in-container `dev` user (match your host user so
# bind-mounted files stay host-owned). `just dev` rewrites these automatically.
HOST_UID=1000
HOST_GID=1000

# Where the bunyip-api binary listens. The internal-to-Docker bind is fixed in
# compose.dev.yml; this controls the host-side published port.
BUNYIP_API_PORT=4401
BUNYIP_WEB_PORT=4400

# What the API thinks the public-facing URL is (used in OIDC discovery JSON).
BUNYIP_PUBLIC_BASE_URL=http://localhost:4400

# Cookie signing secret. Must be at least 64 bytes in production. The default
# below is the placeholder shipped in .env.example; replace it before deploying
# anywhere reachable from the internet.
COOKIE_SECRET=dev-only-do-not-use-in-prod-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Mock credentials accepted by the dev API. Any seeded email + this password
# succeeds. Disable in prod by setting MOCK_PASSWORD to an empty string.
MOCK_PASSWORD=demo
MOCK_TOTP_CODE=000000

# Optional: create Forgejo issues from in-app feedback submissions. Leave empty
# to disable. Format: "owner/repo". When set, also provide FEEDBACK_FORGEJO_TOKEN.
FEEDBACK_FORGEJO_REPO=
FEEDBACK_FORGEJO_TOKEN=

# Tracing.
RUST_LOG=info,bunyip_api=debug

# ---------------------------------------------------------------------------
# Mokosh-server OIDC client config.
#
# As of the runtime-config refactor, bunyip-web derives issuer + redirect
# URI from `window.location.host` at runtime in production. The vars below
# are FALLBACKS that apply only for local dev (localhost / 127.0.0.1 /
# RFC1918). Setting them in prod has no effect; CI doesn't need to bake
# per-environment values into the image.
#
# The one exception is BUNYIP_OIDC_CLIENT_ID, which is still build-time
# only. Operators register the SAME UUID in every mokosh-server instance
# so one image works against staging + prod. After changing CLIENT_ID,
# `force-recreate` the container so the new value reaches the build env.
#
# Re-register the client with `just register-bunyip-client` in the
# mokosh-server repo when you need a fresh UUID.
# ---------------------------------------------------------------------------

# Local-dev fallback for the IdP URL. Production hosts derive
# `https://msp-api.<window.location.host>` automatically; this is only
# consulted when the SPA is served from localhost / 127.0.0.1 / RFC1918.
BUNYIP_OIDC_ISSUER=https://${USER}-mokosh-api.a8n.run

# UUID of the bunyip-web row in mokosh_auth.oauth_clients. Build-time
# only. Empty until `just register-bunyip-client` is run; paste the
# printed UUID here. Same value in every mokosh-server instance.
BUNYIP_OIDC_CLIENT_ID=

# Local-dev fallback for the OIDC redirect URI. Production derives
# `<window.location.origin>/auth/callback` at runtime. Must still
# match a row in oauth_clients.redirect_uris on the dev mokosh-server.
BUNYIP_OIDC_REDIRECT_URI=https://${USER}-bunyip.a8n.run/auth/callback

# Optional. Defaults to `openid email offline_access` when unset.
BUNYIP_OIDC_SCOPES=openid email offline_access

# ---------------------------------------------------------------------------
# Self-host / production deployment (compose.yml).
#
# These vars drive the published-image reference deployment in compose.yml.
# They are NOT used by compose.dev.yml. See the "Self-host" section in
# README.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Apex host the SPA is served from. Both this name AND msp-api.<this name>
# must resolve to the deployment host so the SPA can reach the API and
# Caddy can issue TLS certs. Example: bunyip.example.com
BUNYIP_HOST=

# Email passed to Let's Encrypt for the edge Caddy's automatic HTTPS.
CADDY_ACME_EMAIL=

# Override the published images (tag/registry). Defaults pull :latest from
# the private dev.a8n.run/psa-systems-private registry (run `docker login
# dev.a8n.run` first). Pin a specific release tag for reproducible deploys,
# e.g. dev.a8n.run/psa-systems-private/bunyip-api:v0.2.0
BUNYIP_API_IMAGE=dev.a8n.run/psa-systems-private/bunyip-api:latest
BUNYIP_WEB_IMAGE=dev.a8n.run/psa-systems-private/bunyip-web:latest

# Edge published ports. Override if 80/443 are taken on the host.
BUNYIP_HTTP_PORT=80
BUNYIP_HTTPS_PORT=443

# Update checking. The instance polls this endpoint hourly and reports the
# result at GET /version. Leave empty to disable. Default is the public
# Forgejo releases/latest endpoint; set a token for a private repo.
BUNYIP_UPDATE_CHECK_URL=https://dev.a8n.run/api/v1/repos/psa-systems/bunyip/releases/latest
BUNYIP_UPDATE_CHECK_TOKEN=
