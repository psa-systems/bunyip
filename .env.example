# Bunyip dev env (dunite-based actix backend).
#
# Copy to .env and tweak. Defaults below are safe for local dev only.
# NOTE: dotenvy needs quotes around values containing spaces, e.g. APP_NAME.

# Host UID/GID for the in-container `dev` user (match your host user so
# bind-mounted files stay host-owned). `just dev` rewrites these automatically.
HOST_UID=1000
HOST_GID=1000

# Host-published ports (container-internal binds are fixed in compose.dev.yml).
BUNYIP_API_PORT=4401
BUNYIP_WEB_PORT=4400

# --- Postgres (the dev `postgres` compose service) -------------------------
POSTGRES_USER=bunyip
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=bunyip
# The api reaches Postgres over the compose network by service name.
DATABASE_URL=postgres://bunyip:devpassword@postgres:5432/bunyip

# --- Core API config -------------------------------------------------------
HOST_IP=0.0.0.0
APP_PORT=4401
ENVIRONMENT=development
APP_NAME="PSA Systems"
# Browser origin allowed by CORS (the bunyip-web SPA).
CORS_ORIGIN=http://localhost:4400
COOKIE_DOMAIN=
RUST_LOG=info,bunyip_api=debug,bunyip_core=info

# --- Secrets (dev placeholders; generate real ones for any deployment) -----
# JWT signing secret (HS256 for session tokens). 32+ chars.
JWT_SECRET=dev-only-jwt-secret-at-least-32-characters-long-000000
# AES-256-GCM at-rest keys for TOTP secrets and Stripe secrets (hex, 32 bytes).
# Generate: openssl rand -hex 32   (omit in dev to use all-zero dev keys.)
TOTP_ENCRYPTION_KEY=
STRIPE_ENCRYPTION_KEY=
# Seed an initial platform admin on first boot (email:password).
SETUP_DEFAULT_ADMIN=admin@bunyip.local:ChangeMeBunyip2026

# --- OIDC provider (Bunyip IS the issuer) ----------------------------------
# Presence of OIDC_ISSUER enables /oauth2/* and /.well-known/*.
OIDC_ISSUER=http://localhost:4401
# Ed25519 signing keys. Generate into ./secrets (gitignored), mounted into the
# api container at /run/secrets/oidc:
#   openssl genpkey -algorithm ed25519 -out secrets/dev-2026.pem
#   openssl pkey -in secrets/dev-2026.pem -pubout -out secrets/dev-2026.pub.pem
OIDC_JWT_PRIVATE_KEY_PATH=/run/secrets/oidc/dev-2026.pem
OIDC_JWT_ACTIVE_KID=dev-2026
OIDC_JWT_PUBLIC_KEYS_DIR=/run/secrets/oidc

# --- Email (SMTP). Disabled in dev. ----------------------------------------
EMAIL_ENABLED=false

# --- Building the private dunite git dependency ----------------------------
# bunyip-core/oci/oidc depend on https://dev.a8n.run/psa-systems/dunite (private).
# The api container needs a Forgejo token (read:repo) to fetch it at build time.
# Generate one in Forgejo and set it here; the dev image configures git to use it.
DUNITE_GIT_TOKEN=

# Optional: create Forgejo issues from in-app feedback. Leave empty to disable.
FEEDBACK_FORGEJO_REPO=
FEEDBACK_FORGEJO_TOKEN=

# ---------------------------------------------------------------------------
# Mokosh-server OIDC client config (RUNTIME, not build-time).
#
# These are CONTAINER environment variables, not build args. The bunyip-web
# container writes them to a same-origin /config.json at startup (see
# bunyip-web/oci-build/entrypoint.sh) and the SPA fetches it once at boot.
# One image therefore serves any environment: change a value, restart the
# container, no rebuild. The dev `web` service in compose.dev-sso.yml passes
# these straight through to the container `environment:`.
#
# issuer + redirect_uri are OPTIONAL: when empty the SPA derives them from
# `window.location.host` at runtime (`https://msp-api.<host>` for the issuer,
# `<origin>/auth/callback` for the redirect). client_id has NO fallback -
# operators register the SAME UUID in every mokosh-server instance so one
# image works against staging + prod. Re-register with
# `just register-bunyip-client` in the mokosh-server repo for a fresh UUID.
# ---------------------------------------------------------------------------

# IdP (mokosh-server) issuer URL. Optional: leave empty to use the
# host-derived `https://msp-api.<window.location.host>`.
BUNYIP_OIDC_ISSUER=https://${USER}-mokosh-api.a8n.run

# UUID of the bunyip-web row in mokosh_auth.oauth_clients. Required for SSO.
# Empty until `just register-bunyip-client` is run; paste the printed UUID
# here. Same value in every mokosh-server instance.
BUNYIP_OIDC_CLIENT_ID=

# OIDC redirect URI. Optional: leave empty to use the host-derived
# `<window.location.origin>/auth/callback`. When set it must match a row in
# oauth_clients.redirect_uris on the mokosh-server.
BUNYIP_OIDC_REDIRECT_URI=https://${USER}-bunyip.a8n.run/auth/callback

# Optional. Defaults to `openid email offline_access` when unset.
BUNYIP_OIDC_SCOPES=openid email offline_access

# ---------------------------------------------------------------------------
# Self-host / production deployment (compose.yml).
#
# These vars drive the published-image reference deployment in compose.yml.
# They are NOT used by compose.dev.yml. See the "Self-host" section in
# README.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Apex host the SPA is served from. Both this name AND msp-api.<this name>
# must resolve to the deployment host so the SPA can reach the API and
# Caddy can issue TLS certs. Example: bunyip.example.com
BUNYIP_HOST=

# Email passed to Let's Encrypt for the edge Caddy's automatic HTTPS.
CADDY_ACME_EMAIL=

# Override the published images (tag/registry). Defaults pull :latest from
# the private dev.a8n.run/psa-systems-private registry (run `docker login
# dev.a8n.run` first). Pin a specific release tag for reproducible deploys,
# e.g. dev.a8n.run/psa-systems-private/bunyip-api:v0.2.0
BUNYIP_API_IMAGE=dev.a8n.run/psa-systems-private/bunyip-api:latest
BUNYIP_WEB_IMAGE=dev.a8n.run/psa-systems-private/bunyip-web:latest

# Edge published ports. Override if 80/443 are taken on the host.
BUNYIP_HTTP_PORT=80
BUNYIP_HTTPS_PORT=443

# Update checking. The instance polls this endpoint hourly and reports the
# result at GET /version. Leave empty to disable. Default is the public
# Forgejo releases/latest endpoint; set a token for a private repo.
BUNYIP_UPDATE_CHECK_URL=https://dev.a8n.run/api/v1/repos/psa-systems/bunyip/releases/latest
BUNYIP_UPDATE_CHECK_TOKEN=
