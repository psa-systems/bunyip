# Bunyip PRODUCTION environment file - for a self-hosted deployment.
#
# Copy to .env next to compose.yml and fill in every placeholder below before
# `docker compose up`. This is NOT a copy of .env.example: it carries no dev
# value, ENVIRONMENT is already `production`, and it lists only the settings a
# self-host must look at - everything else compose.yml already defaults
# correctly. Never copy .env.example for a deployment; that file is the dev
# file `just dev` / `just dev-sso` read.
#
# NOTE: dotenvy needs quotes around values containing spaces, e.g. APP_NAME.
# The complete catalogue of every variable, its default, and which process
# reads it is docs/configuration.md; the deploy procedure is
# docs/self-hosting.md.


# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENTAL
# ═══════════════════════════════════════════════════════════════════════════

# Turns on the strict posture: email must resolve to enabled or the api
# refuses to start (BUNYIP-204), an OIDC kid starting with `dev-` panics at
# boot (BUNYIP-258), and JWT_SECRET / BUNYIP_WEBHOOK_SIGNING_SECRET lose their
# dev fallbacks. compose.yml already defaults to `production` when this is
# unset; it is spelled out here so a self-host never depends on that default
# holding.
ENVIRONMENT=production


# ═══════════════════════════════════════════════════════════════════════════
# HOSTING
# ═══════════════════════════════════════════════════════════════════════════

# BUNYIP-237: REQUIRED. compose.yml refuses to start without a pinned release
# tag for each image (no `:latest` - see the compose.yml comment on the `api`
# service for why). Bump both together when promoting a release.
BUNYIP_API_IMAGE=dev.a8n.run/psa-systems-private/bunyip-api:v0.4.1
BUNYIP_WEB_IMAGE=dev.a8n.run/psa-systems-private/bunyip-web:v0.4.1

# Browser-facing origin of bunyip-api (BUNYIP-192 / BUNYIP-510), used for the
# dashboard SSE subscriber and the Stripe webhook URL the admin page
# prefills. Unset falls back to the internal BUNYIP_API_URL, which no browser
# and no Stripe delivery can reach.
BUNYIP_API_PUBLIC_ORIGIN=https://api.bunyip.example.com


# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════════════

# Public origin(s) bunyip-web is served from, comma-separated. BUNYIP-423:
# also the CSRF allow-list - a browser origin missing here gets its
# cookie-authenticated POST/PUT/PATCH/DELETE refused with 403.
CORS_ORIGIN=https://bunyip.example.com

# REQUIRED (BUNYIP-749): compose.yml has no default for either and aborts
# `docker compose up` without them. The app's own public base URL (email
# links, EHLO fallback) and the bunyip-web login UI origin (the OIDC authorize
# handler's bounce target) - both the same host as CORS_ORIGIN for a
# single-origin deployment.
APP_URL=https://bunyip.example.com
BUNYIP_WEB_ORIGIN=https://bunyip.example.com


# ═══════════════════════════════════════════════════════════════════════════
# SECURITY AND SECRETS
# ═══════════════════════════════════════════════════════════════════════════
#
# Group-1 startup secrets (postgres, JWT_SECRET, APP_ENCRYPTION_KEY, ...) are
# file-based, never .env values: run ./scripts/init-secrets.nu, or supply the
# SOPS compose-secrets.yml on the docker hosts, before `docker compose up`.
# See the compose.yml header and docs/self-hosting.md.

# ── Where the governed secrets live (BUNYIP-542) ────────────────────────────
# environment | database | infisical. REQUIRED: compose.yml has no default
# and aborts without it, and the api exits with an explanatory error on an
# unrecognised value. It declares the ONE store holding the SMTP password and
# the two Stripe secrets; nothing else is consulted, so a copy in an
# undeclared store is reported rather than silently used. Left unset here on
# purpose so the abort still fires and the operator makes the declaration
# deliberately, rather than inheriting a dev default.
# Migration between stores: docs/secrets-infisical.md.
# SECRETS_STORAGE=database


# ═══════════════════════════════════════════════════════════════════════════
# IDENTITY PROVIDER (OIDC)
# ═══════════════════════════════════════════════════════════════════════════

# Presence of OIDC_ISSUER enables /oauth2/* and /.well-known/*. Set it to the
# public api origin to act as the OIDC issuer for the rest of the PSA suite;
# leave unset to keep the provider disabled.
OIDC_ISSUER=https://api.bunyip.example.com

# Ed25519 signing keys. Generate into ./secrets/oidc (gitignored), mounted
# into the api container at /run/secrets/oidc:
#   openssl genpkey -algorithm ed25519 -out secrets/oidc/prod-2026.pem
#   openssl pkey -in secrets/oidc/prod-2026.pem -pubout -out secrets/oidc/prod-2026.pub.pem
#
# BUNYIP-258: both REQUIRED, no default in compose.yml. The kid must NOT
# start with `dev-` (the api panics at boot on ENVIRONMENT=production).
OIDC_JWT_PRIVATE_KEY_PATH=/run/secrets/oidc/prod-2026.pem
OIDC_JWT_ACTIVE_KID=prod-2026
