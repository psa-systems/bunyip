# bunyip-web (Axum SSR) configuration. Read from the environment at startup
# (see src/config.rs).

# Address the server binds to.
BUNYIP_BIND_ADDR=0.0.0.0:4400

# Base URL of the separate bunyip-api service, WITHOUT the trailing /v1
# (e.g. http://localhost:4401 in dev). The frontend calls this server-side and
# forwards the apex-scoped session cookie. This same origin is bunyip's OWN
# OIDC issuer (it serves /.well-known/* + /oauth2/* alongside /v1).
BUNYIP_API_URL=http://localhost:4401

# OIDC issuer the BFF trusts. Defaults to BUNYIP_API_URL (bunyip-api is the
# issuer). Only set this if the issuer origin differs from the API origin.
# BUNYIP_OIDC_ISSUER=http://localhost:4401

# Apex domain child apps live under (used to build app launch URLs + legal copy).
BUNYIP_APP_DOMAIN=localhost

# BUNYIP-329: URL of the team Let's Chat ("Community") instance the Community
# button opens. Empty (default) hides the button and disables the feature, so a
# deploy without a Let's Chat instance never shows a dead link. Let's Chat is
# already an OIDC client of bunyip-api, so opening this URL logs the member in
# via their existing session. Point it at the login-init path so the OIDC flow
# fires immediately (staging/prod example: https://chat.a8n.systems/auth/bunyip).
# BUNYIP_COMMUNITY_URL=

# BUNYIP-500: per-skin theme override. Raw CSS custom-property declarations for
# the brand ramp, emitted into a :root {} block in the document head. The brand
# @theme tokens read var(--skin-*, <default>), so setting these recolors the UI.
# Unset (default) emits nothing, so the default (Bunyip reed/water) palette is
# used. Example (dotenvy needs quotes):
# BRAND_THEME_CSS="--skin-primary-500:#4f46e5;--skin-primary-700:#3730a3;--skin-accent-500:#0ea5e9;"

# BUNYIP-549: the two <meta name="theme-color"> values that paint the browser
# chrome (Android address bar, iOS status bar, PWA splash) under
# prefers-color-scheme: light and dark. BRAND_THEME_CSS recolors every in-page
# token, so a skin sets these alongside it or the chrome stays Bunyip reed-green.
# Defaults are Bunyip's reed-700 and dark surface, so unskinned output is
# unchanged.
# BRAND_THEME_COLOR_LIGHT="#2f4e2e"
# BRAND_THEME_COLOR_DARK="#161a16"

# BUNYIP-499: app/brand name shown in the nav brand mark and appended as the
# browser-title suffix (" · {APP_NAME}"). Defaults to "Bunyip" when unset, so the
# default skin is byte-identical. Set it (dotenvy needs quotes for a value with
# spaces) to rebrand the web UI for a skin. This is bunyip-web's OWN APP_NAME;
# bunyip-api reads a separate APP_NAME for email branding.
# APP_NAME="Bunyip"

# BUNYIP-501: the <meta name="description"> copy (skin marketing text). Defaults
# to bunyip's description when unset, so output is unchanged. Set it (dotenvy
# needs quotes) to rebrand the framework's document head for a skin.
# BRAND_DESCRIPTION="Bunyip - the SaaS layer for your PSA. Auth, billing, members, and identity for Mokosh."

# BUNYIP-503: cross-origin hosts a skin appends to the Content-Security-Policy,
# comma-separated, so a deploy with different third-party integrations extends
# the allow-list without editing security.rs. connect-src is for fetch / XHR /
# SSE hosts, form-action for cross-origin form posts (e.g. a payment provider
# other than Stripe). script-src / default-src / frame-ancestors stay locked and
# are never extended by config. Unset (default) leaves bunyip's CSP unchanged.
# CSP_CONNECT_SRC="https://api.example.com,https://sentry.example.com"
# CSP_FORM_ACTION="https://pay.example.com"

# Optional: log level.
RUST_LOG=info
