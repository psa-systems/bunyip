# bunyip-web (Axum SSR) configuration. Read from the environment at startup
# (see src/config.rs).

# Address the server binds to.
BUNYIP_BIND_ADDR=0.0.0.0:4400

# Base URL of the separate bunyip-api service, WITHOUT the trailing /v1
# (e.g. http://localhost:4401 in dev). The frontend calls this server-side and
# forwards the apex-scoped session cookie. This same origin is bunyip's OWN
# OIDC issuer (it serves /.well-known/* + /oauth2/* alongside /v1).
BUNYIP_API_URL=http://localhost:4401

# OIDC issuer the BFF trusts. Defaults to BUNYIP_API_URL (bunyip-api is the
# issuer). Only set this if the issuer origin differs from the API origin.
# BUNYIP_OIDC_ISSUER=http://localhost:4401

# Apex domain child apps live under (used to build app launch URLs + legal copy).
BUNYIP_APP_DOMAIN=localhost

# BUNYIP-329: URL of the team Let's Chat ("Community") instance the Community
# button opens. Empty (default) hides the button and disables the feature, so a
# deploy without a Let's Chat instance never shows a dead link. Let's Chat is
# already an OIDC client of bunyip-api, so opening this URL logs the member in
# via their existing session. Point it at the login-init path so the OIDC flow
# fires immediately (staging/prod example: https://chat.a8n.systems/auth/bunyip).
# BUNYIP_COMMUNITY_URL=

# BUNYIP-500: per-skin theme override. Raw CSS custom-property declarations for
# the brand ramp, emitted into a :root {} block in the document head. The brand
# @theme tokens read var(--skin-*, <default>), so setting these recolors the UI.
# Unset (default) emits nothing, so the default (Bunyip reed/water) palette is
# used. Example (dotenvy needs quotes):
# BRAND_THEME_CSS="--skin-primary-500:#4f46e5;--skin-primary-700:#3730a3;--skin-accent-500:#0ea5e9;"

# Optional: log level.
RUST_LOG=info
