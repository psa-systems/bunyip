{
    auto_https off
    admin off
}

:{$PORT} {
    root * /usr/share/caddy
    encode gzip zstd

    # SPA fallback: serve index.html for missing files (client-side routing).
    try_files {path} /index.html

    file_server

    header {
        # Cache hashed assets (wasm/js/css) aggressively.
        ?Cache-Control "public, max-age=31536000, immutable"
        # Baseline security headers. CSP intentionally absent here;
        # add a tuned CSP after the security audit pass (Dioxus WASM
        # needs `script-src 'self' 'wasm-unsafe-eval'` and the
        # mokosh-server origin in `connect-src`).
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    @html path *.html
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    # Runtime OIDC config (written from env by entrypoint.sh). Never cache,
    # so changing BUNYIP_OIDC_* + restart takes effect on the next load.
    @config path /config.json
    header @config Cache-Control "no-store"
}
